      "ddd": null,
      "expected": { "telefone": "5534998100001", "colunaPrincipal": "Telefone 1", "brutoPrincipal": "(34) 99810-0001", "extras": [ { "telefone": "5534998100002", "coluna": "Telefone 2" } ] }
    },
