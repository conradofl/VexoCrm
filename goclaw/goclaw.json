{
  "llm": {
    "providers": {
      "gemini": {
        "driver": "openai",
        "baseURL": "https://generativelanguage.googleapis.com/v1beta/openai/",
        "apiKey": "${GEMINI_API_KEY}",
        "thinkingLevel": "off"
      },
      "groq": {
        "driver": "openai",
        "baseURL": "https://api.groq.com/openai/v1",
        "apiKey": "${GROQ_API_KEY}",
        "thinkingLevel": "off"
      }
    },
    "agent": {
      "models": [
        "gemini/gemini-3-flash-preview",
        "groq/openai/gpt-oss-120b",
        "gemini/gemini-flash-latest"
      ]
    },
    "subagent": {
      "models": [
        "gemini/gemini-3.1-flash-lite-preview",
        "groq/openai/gpt-oss-20b"
      ]
    },
    "summarization": {
      "models": [
        "gemini/gemini-3.1-flash-lite-preview",
        "groq/openai/gpt-oss-20b"
      ]
    }
  },
  "thinking": false,
  "channels": {
    "telegram": {
      "enabled": false
    },
    "whatsapp": {
      "enabled": false
    },
    "http": {
      "enabled": true,
      "listen": ":1337"
    }
  },
  "session": {
    "store": "sqlite",
    "storePath": "./data/goclaw_sessions.db",
    "inherit": false
  },
  "lanes": {
    "maestro": {
      "name": "COO Maestro",
      "model": "gemini/gemini-3-flash-preview",
      "promptFile": "prompts/maestro_coo.md"
    },
    "onboarding": {
      "name": "Gestor Digital Onboarding",
      "model": "gemini/gemini-3-flash-preview",
      "promptFile": "prompts/gestor_digital_onboarding.md"
    },
    "demandas_cron": {
      "name": "Auditor de Demandas & Prazos",
      "model": "gemini/gemini-3-flash-preview",
      "promptFile": "prompts/gestor_demandas_auditor.md"
    }
  }
}
