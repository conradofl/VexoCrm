{
  "llm": {
    "providers": {
      "groq": {
        "driver": "openai",
        "baseURL": "https://api.groq.com/openai/v1",
        "apiKey": "${GROQ_API_KEY}"
      },
      "gemini": {
        "driver": "openai",
        "baseURL": "https://generativelanguage.googleapis.com/v1beta/openai/",
        "apiKey": "${GEMINI_API_KEY}"
      }
    },
    "agent": {
      "models": [
        "llama-3.3-70b-versatile",
        "gemini-1.5-flash"
      ]
    },
    "subagent": {
      "models": [
        "llama-3.1-8b-instant",
        "gemini-1.5-flash"
      ]
    }
  },
  "channels": {
    "telegram": {
      "enabled": false
    },
    "whatsapp": {
      "enabled": true
    },
    "http": {
      "enabled": true,
      "listen": ":1337"
    }
  },
  "session": {
    "store": "sqlite",
    "storePath": "./data/goclaw_sessions.db",
    "inherit": false
  },
  "lanes": {
    "maestro": {
      "name": "COO Maestro",
      "model": "llama-3.3-70b-versatile",
      "promptFile": "prompts/maestro_coo.md"
    },
    "onboarding": {
      "name": "Gestor Digital Onboarding",
      "model": "llama-3.3-70b-versatile",
      "promptFile": "prompts/gestor_digital_onboarding.md"
    },
    "demandas_cron": {
      "name": "Auditor de Demandas & Prazos",
      "model": "llama-3.3-70b-versatile",
      "promptFile": "prompts/gestor_demandas_auditor.md"
    }
  }
}
